[
  {
    "term_id": "t001",
    "en": "mash",
    "zh": "糖化",
    "category": "糖化",
    "definition": "粉碎麦芽与水混合并控温保温，让酶把淀粉分解成可发酵糖的过程。",
    "note": "糖化是酿酒的第一道工艺关，温度差一两度，酒的干湿就不一样。",
    "keywords": "糖化 麦芽 淀粉 酶",
    "verified": false,
    "source_ref": "以本厂 SOP 为准"
  },
  {
    "term_id": "t002",
    "en": "sparge",
    "zh": "洗糟",
    "category": "糖化",
    "definition": "糖化结束后用热水冲洗麦糟，把残留的糖洗出来。",
    "note": "水温过高会洗出涩味物质，宁稳勿猛。",
    "keywords": "洗糟 冲洗 麦糟",
    "verified": false,
    "source_ref": "以本厂 SOP 为准"
  },
  {
    "term_id": "t003",
    "en": "lauter",
    "zh": "麦汁过滤（过滤槽）",
    "category": "糖化",
    "definition": "把糖化醅分离成清亮麦汁和湿麦糟的工序，设备叫过滤槽（lauter tun）。",
    "note": "过滤速度慢，多半是前道粉碎和糖化留的债。",
    "keywords": "过滤槽 麦汁 分离",
    "verified": false,
    "source_ref": "以本厂 SOP 为准"
  },
  {
    "term_id": "t004",
    "en": "vorlauf",
    "zh": "回流澄清",
    "category": "糖化",
    "definition": "过滤初期把浑浊麦汁打回过滤槽重新过滤，直到清亮才进煮沸锅。",
    "note": "回流这道小步骤省不得，浑汁进锅后面全是麻烦。",
    "keywords": "回流 澄清 浑浊",
    "verified": false,
    "source_ref": "以本厂 SOP 为准"
  },
  {
    "term_id": "t005",
    "en": "mash-out",
    "zh": "糖化休止升温（终了）",
    "category": "糖化",
    "definition": "糖化结束前把醅温升到较高温度，灭酶、降粘、利于过滤。",
    "note": "升温要匀，猛升温会把醅烫结块。",
    "keywords": "休止 升温 灭酶",
    "verified": false,
    "source_ref": "以本厂 SOP 为准"
  },
  {
